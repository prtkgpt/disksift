# Neon Postgres (use the pooled URL for the Vercel application)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Blog CMS admin
BLOG_ADMIN_EMAIL=""
BLOG_ADMIN_PASSWORD=""
# Generate with: openssl rand -base64 48
BLOG_SESSION_SECRET=""
BLOG_NOTIFICATION_EMAIL=""

# Transactional email (server-side only)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="DiskSift <hello@disksift.com>"
SUPPORT_EMAIL="hello@disksift.com"

# Auth (Auth.js / NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# Stripe payments. Start with test; change all four mode-specific values together.
STRIPE_MODE="test"
ALLOW_LIVE_PAYMENTS="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
# Legacy alias accepted by the app: STRIPE_PRICE_ID
SITE_URL="http://localhost:3000"

# Generate independently with: openssl rand -base64 48
DISKSIFT_LICENSE_SECRET=""
