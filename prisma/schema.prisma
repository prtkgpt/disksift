generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum EventLocationType {
  VIDEO
  PHONE
  IN_PERSON
  CUSTOM
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  emailVerified DateTime?
  image        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  teams        TeamMember[]
  bookingTypes BookingType[]
  bookings     Booking[] @relation("HostBookings")
  accounts     Account[]
  sessions     Session[]
}

model Team {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   TeamMember[]
  bookingTypes BookingType[]
}

model TeamMember {
  id        String   @id @default(cuid())
  role      String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  team      Team     @relation(fields: [teamId], references: [id])
  teamId    String
  createdAt DateTime @default(now())
}

model BookingType {
  id              String     @id @default(cuid())
  title           String
  slug            String
  description     String?
  durationMinutes Int
  priceCents      Int?
  currency        String?    @default("USD")
  locationType    EventLocationType @default(VIDEO)
  locationValue   String?
  host            User       @relation(fields: [hostId], references: [id])
  hostId          String
  team            Team?      @relation(fields: [teamId], references: [id])
  teamId          String?
  availability    Availability[]
  bookings        Booking[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([hostId, slug])
}

model Availability {
  id            String   @id @default(cuid())
  bookingType   BookingType @relation(fields: [bookingTypeId], references: [id])
  bookingTypeId String
  dayOfWeek     Int
  startMinutes  Int
  endMinutes    Int
  createdAt     DateTime @default(now())
}

model Booking {
  id            String        @id @default(cuid())
  bookingType   BookingType   @relation(fields: [bookingTypeId], references: [id])
  bookingTypeId String
  host          User          @relation("HostBookings", fields: [hostId], references: [id])
  hostId        String
  guestName     String
  guestEmail    String
  startTime     DateTime
  endTime       DateTime
  status        BookingStatus @default(PENDING)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  payment       Payment?
}

model Payment {
  id           String   @id @default(cuid())
  booking      Booking  @relation(fields: [bookingId], references: [id])
  bookingId    String   @unique
  stripeIntent String?
  stripeSessionId String?
  amountCents  Int
  currency     String
  status       String
  createdAt    DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
